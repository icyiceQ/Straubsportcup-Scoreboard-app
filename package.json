{
  "name": "unihockey-scoreboard",
  "productName": "Unihockey Scoreboard",
  "version": "1.0.0",
  "description": "Scoreboard für Unihockey-Meisterschaft: Ligen, Spielabende, Matchuhr mit Pause",
  "author": "Kjell Ita",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "set SCOREBOARD_SELFTEST=1&& electron .",
    "dist": "npm run dist:win-x64 && npm run dist:win-arm64",
    "dist:win-x64": "electron-builder --win portable --x64 --publish never",
    "dist:win-arm64": "electron-builder --win portable --arm64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "build": {
    "appId": "ch.unihockey.scoreboard",
    "productName": "Unihockey Scoreboard",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Unihockey-Scoreboard-Windows-${arch}.exe"
    },
    "mac": {
      "category": "public.app-category.sports",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Unihockey-Scoreboard-macOS-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
